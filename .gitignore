# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# android (TWA + Capacitor 공통 — 빌드 산출물·키스토어 제외)
/android/app/build
/android/build
/android/.gradle
/android/local.properties
/android/captures
# Bubblewrap 산출물 (빌드 시 생성됨)
/android/app-release-signed.aab
/android/app-release-signed.apk
/android/app-release-unsigned.apk
/android/app/
/android/gradle/
/android/gradlew
/android/gradlew.bat
/android/build.gradle
/android/settings.gradle
/android/store_icon.png
# 키스토어 — 절대 commit 금지! 분실 시 앱 업데이트 영원히 불가.
/android/*.keystore
/android/*.jks
/android/signing-key-info.txt
# 자동 캡처 스크린샷 (소스에 두지 말고 별도 보관)
/android/screenshots

# IDE
.idea
.vscode/launch.json

# 임시 파일
/tmp
*.log

.vercel
logo-source.png
.git-commit-msg.txt

lint-report.txt

# Codex/QA screenshots and temporary generated assets
.codex-*.png
.tmp-*.png
.tmp-*.jpg
.tmp-*.jpeg
.tmp-*.webp
tmp-*.png
tmp-*.jpg
tmp-*.jpeg
tmp-*.webp
tmp-sensitive-tests/
ian-four-check.png
*.tmp.webp
**/_backup_before_*/

# Local promo render outputs
/promo/*.mp4
/promo/*.jpg
/promo/*.png

# Android release artifacts generated locally
/android/*.aab
/android/*.apk
/android/*.apk.idsig
