# =============================================================================
# 인생의 회전목마 (Carousel of Life) - 환경변수 템플릿
# =============================================================================
# 이 파일을 복사해서 .env.local 로 저장한 뒤 실제 값을 채워 넣으세요.
# .env.local 은 절대 Git 에 커밋하지 마세요.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase
# -----------------------------------------------------------------------------
# https://app.supabase.com 에서 프로젝트 생성 후 Settings > API 에서 확인.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Supabase Postgres 직접 연결 (Drizzle 마이그레이션/쿼리용).
# Settings > Database > Connection string > URI (password 포함된 풀 URL).
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project-ref.supabase.co:5432/postgres
# 구형/개별 마이그레이션 스크립트 호환용 별칭. 비워두면 DATABASE_URL 을 사용.
# SUPABASE_DB_URL=

# -----------------------------------------------------------------------------
# Anthropic (Claude API) - 진지한 점술사 페르소나 구동
# -----------------------------------------------------------------------------
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-api-key

# -----------------------------------------------------------------------------
# PortOne V2 - 한국 PG 통합 게이트웨이 (1순위 결제)
# -----------------------------------------------------------------------------
# https://admin.portone.io
PORTONE_API_SECRET=your-portone-api-secret
PORTONE_WEBHOOK_SECRET=your-portone-webhook-secret
NEXT_PUBLIC_PORTONE_STORE_ID=your-store-id
# KCP 카드 채널 키 (필수 — 라이트/프로 모두 카드 결제 기본)
NEXT_PUBLIC_PORTONE_CHANNEL_KEY=your-kcp-channel-key
# KCP 사이트코드 (PG 심사·운영 확인용)
KCP_SITE_CODE=IP7W1
# 카카오페이 정기결제 채널 키 (선택 — 비우면 카카오페이 버튼 숨김)
# 카카오페이 가맹 승인 후 PortOne 콘솔에서 채널 추가 → 발급 키 등록
NEXT_PUBLIC_PORTONE_CHANNEL_KEY_KAKAO=
# 가격은 src/lib/constants.ts 의 SUBSCRIPTION 상수를 단일 출처로 사용함.
# 환경변수로 가격을 다루지 않아 UI 노출가와 결제창 금액이 항상 일치.
# 운영 스크립트 호환용 가격 override (선택). 일반 앱 화면/결제 금액에는 사용하지 않음.
# PORTONE_LITE_PRICE_KRW=
# PORTONE_PRO_PRICE_KRW=

# -----------------------------------------------------------------------------
# TossPayments - 폴백 PG (선택)
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_TOSS_CLIENT_KEY=
# TOSS_SECRET_KEY=
# TOSS_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Web Push (VAPID) - 매일 알림
# -----------------------------------------------------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:diabloss9999@gmail.com

# -----------------------------------------------------------------------------
# Cron 보안 — Vercel Cron 에서만 호출 허용
# -----------------------------------------------------------------------------
CRON_SECRET=

# -----------------------------------------------------------------------------
# Kakao OAuth (Supabase Auth 에서도 별도 설정 필요)
# -----------------------------------------------------------------------------
# https://developers.kakao.com/console
KAKAO_CLIENT_ID=your-kakao-rest-api-key
KAKAO_CLIENT_SECRET=your-kakao-client-secret

# -----------------------------------------------------------------------------
# Kakao Share SDK (카카오톡 공유)
# -----------------------------------------------------------------------------
# 카카오 디벨로퍼 콘솔 > 앱 키 > JavaScript 키.
NEXT_PUBLIC_KAKAO_JAVASCRIPT_KEY=
# 기존 문서 호환 별칭. 새 설정은 위 변수명을 우선 사용.
# NEXT_PUBLIC_KAKAO_JS_KEY=

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=인생의 회전목마
# Android/Capacitor 앱에서 로드할 서버 URL override (선택)
# CAPACITOR_SERVER_URL=https://carouseloflife.com
# 특정 날짜(KST)에 유료 기능 무료 개방 (선택, 예: 2026-05-27)
# PROMO_FREE_DAY=

# -----------------------------------------------------------------------------
# 사업자 정보 (통신판매업·푸터·약관 페이지에 노출)
# 빈 값일 경우 자리표시자("[대표자명]" 등) 가 표시된다.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_OWNER_NAME=
NEXT_PUBLIC_ECOMMERCE_NUMBER=
NEXT_PUBLIC_BUSINESS_ADDRESS=
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_BUSINESS_PHONE=

# 노드 환경 (development | production | test). Vercel 이 자동 주입.
NODE_ENV=development
