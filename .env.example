# =============================================================================
# 인생의 회전목마 (Carousel of Life) - 환경변수 템플릿
# =============================================================================
# 이 파일을 복사해서 .env.local 로 저장한 뒤 실제 값을 채워 넣으세요.
# .env.local 은 절대 Git 에 커밋하지 마세요.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase
# -----------------------------------------------------------------------------
# https://app.supabase.com 에서 프로젝트 생성 후 Settings > API 에서 확인.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Supabase Postgres 직접 연결 (Drizzle 마이그레이션/쿼리용).
# Settings > Database > Connection string > URI (password 포함된 풀 URL).
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project-ref.supabase.co:5432/postgres

# -----------------------------------------------------------------------------
# Anthropic (Claude API) - 진지한 점술사 페르소나 구동
# -----------------------------------------------------------------------------
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-api-key

# -----------------------------------------------------------------------------
# PortOne V2 - 한국 PG 통합 게이트웨이 (1순위 결제)
# -----------------------------------------------------------------------------
# https://admin.portone.io
PORTONE_API_SECRET=your-portone-api-secret
PORTONE_WEBHOOK_SECRET=your-portone-webhook-secret
NEXT_PUBLIC_PORTONE_STORE_ID=your-store-id
NEXT_PUBLIC_PORTONE_CHANNEL_KEY=your-channel-key
# 가격은 src/lib/constants.ts 의 SUBSCRIPTION 상수를 단일 출처로 사용함.
# 환경변수로 가격을 다루지 않아 UI 노출가와 결제창 금액이 항상 일치.

# -----------------------------------------------------------------------------
# TossPayments - 폴백 PG (선택)
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_TOSS_CLIENT_KEY=
# TOSS_SECRET_KEY=
# TOSS_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Web Push (VAPID) - 매일 알림
# -----------------------------------------------------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:diabloss9999@gmail.com

# -----------------------------------------------------------------------------
# Cron 보안 — Vercel Cron 에서만 호출 허용
# -----------------------------------------------------------------------------
CRON_SECRET=

# -----------------------------------------------------------------------------
# Kakao OAuth (Supabase Auth 에서도 별도 설정 필요)
# -----------------------------------------------------------------------------
# https://developers.kakao.com/console
KAKAO_CLIENT_ID=your-kakao-rest-api-key
KAKAO_CLIENT_SECRET=your-kakao-client-secret

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=인생의 회전목마

# -----------------------------------------------------------------------------
# 사업자 정보 (통신판매업·푸터·약관 페이지에 노출)
# 빈 값일 경우 자리표시자("[대표자명]" 등) 가 표시된다.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_OWNER_NAME=
NEXT_PUBLIC_ECOMMERCE_NUMBER=
NEXT_PUBLIC_BUSINESS_ADDRESS=
NEXT_PUBLIC_SUPPORT_EMAIL=

# 노드 환경 (development | production | test). Vercel 이 자동 주입.
NODE_ENV=development
